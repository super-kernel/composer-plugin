{
    "name": "super-kernel/composer-plugin",
    "type": "composer-plugin",
    "description": "The Composer plugin for super kernel framework.",
    "license": "MIT",
    "version": "1.0.0",
    "scripts": {
        "dev": "@composer skernel dev",
        "build": "@composer skernel dev"
    },
    "extra": {
        "class": "SuperKernel\\ComposerPlugin\\ComposerPlugin",
        "plugin-optional": true
    },
    "config": {
        "optimize-autoloader": true,
        "process-timeout": 0,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "SuperKernel\\ComposerPlugin\\": "src/"
        }
    },
    "require": {
        "composer-plugin-api": "^2.6",
        "composer/composer": "^2.8",
        "nikic/php-parser": "^5.6"
    }
}